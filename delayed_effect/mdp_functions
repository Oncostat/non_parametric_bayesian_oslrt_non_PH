generate_exp <- function(sampling, s, nexp){
  the_s <- sampling$The[s]
  u <- runif(nexp)
  Tgen <- sampling$G_ppf(u, the_s, sampling$Dat$lambda)
  return(Tgen)
}

build_exp <- function(Texp, Cexp, tau){
  #C_clin <- sample(Cexp, size = length(Texp), replace = TRUE)
  C_adm <- rep(tau, length(Texp))
  #Cens <- pmin(C_clin, C_adm)
  t_exp <- pmin(Texp, C_adm)
  delta_exp <- as.numeric(Texp <= C_adm)
  list(time = t_exp, status = delta_exp)
}

################################################################################
########################Z_DE bayesian###########################################
################################################################################

DE_bayesian_unique <- function(sampling, CP, t_exp, delta_exp, s){
  data <- data.frame(t = t_exp, e = delta_exp)
  data2 <- arrange(data, t)
  t_CP <- data2$t[which(data2$t>CP)]
  delta_CP <- data2$e[which(data2$t>CP)]
  
  grid <- sort(unique(c(t_CP, CP)))
  S_grid <- dirichlet_unique(sampling = sampling, s = s, grid = grid)
  
  S_DP <- S_grid[match(t_CP, grid)]
  H_DP <- -log(S_DP)  #H0 de Z_DE adapte au DP  
  
  S_DP_CP <- S_grid[match(CP, grid)]
  H_DP_CP <- -log(S_DP_CP)  #H0_CP de Z_DE adapte au DP
  H_CP <- rep(H_DP_CP, length(t_CP))  #H_tau de Z_DE adapte au DP
  
  Num <- sum(delta_CP - H_DP + H_CP)
  Var <- sum(H_DP- H_CP)
  Z_DE <- Num/sqrt(Var)
  return(Z_DE)
}


################################################################################
##########################Simulate H0###########################################
################################################################################

simulate_Z <- function(sampling, Cexp, nexp, CP, tau, net){
  B <- ncol(sampling$Tim)
  Z_DE <- numeric(B*net)
  idx <- 1
  for(s in 1:B){
    for(e in 1:net){
      Texp <- generate_exp(sampling = sampling, s = s, nexp = nexp)
      data_exp <- build_exp(Texp = Texp, Cexp = Cexp, tau = tau)
      Z_DE[idx] <- DE_bayesian_unique(sampling = sampling, CP = CP, t_exp = data_exp$time, delta_exp = data_exp$status, s = s)
      idx <- idx+1
    }
  }
  return(Z_DE)
}


################################################################################
######################Computation of pval#######################################
################################################################################

compute_pval <- function(sampling, T_exp_obs, delta_exp_obs, CP, rate_exp, shape_weib, scale_weib, shape_llogis,
                         scale_llogis, mean_lnorm, sd_lnorm, mu_gengamma, sigma_gengamma, Q_gengamma, distr, tau, net){
  Z_DE <- Score_DE(time = T_exp_obs, event = delta_exp_obs, CP = CP, rate_exp = rate_exp, shape_weib = shape_weib, 
                   scale_weib = scale_weib, shape_llogis = shape_llogis, scale_llogis = scale_llogis, 
                   mean_lnorm = mean_lnorm, sd_lnorm = sd_lnorm, mu_gengamma = mu_gengamma, sigma_gengamma = sigma_gengamma, 
                   Q_gengamma = Q_gengamma, distr = distr)[1]
  nexp <- length(T_exp_obs)
  C_obs <- T_exp_obs[which(delta_exp_obs==0)]
  Z_sim <- simulate_Z(sampling = sampling, Cexp = C_obs, nexp = nexp, CP = CP, tau = tau, net = net)
  pvalue <- mean(na.omit(Z_sim <= Z_DE))
  return(pvalue)
}

################################################################################
########################Parallelisation#########################################
################################################################################

one_sim <- function(i, nexp, shape0, scale0, CP_gen, CP, sampling_cont, len, shape1, scale1,
                    ta, tf, lambda_cens, net){
  set.seed(i)
  
  time <- rweibull(n = nexp, shape = shape1, scale = scale1)
  #time <- nphsim::rpwexp(n = nexp, rate = c(1/scale0*1, 1/scale0*0.5), intervals = CP_gen, cumulative = FALSE)
  u <- runif(n = nexp, min = 0, max = ta)
  
  if(lambda_cens==0){  #administrative censoring
    del <- rep(1, nexp)
    t <- pmin(time, ta+tf-u)
    delta <- ifelse(time < ta+tf-u, del, 0)
  }
  else{   #lost during FU + administrative censoring
    cens <- stats::rexp(nexp, lambda_cens)
    time <- ifelse(time < cens, time, cens)
    del <- ifelse(time < cens, 1, 0)
    t <- pmin(time, ta+tf-u)
    delta <- ifelse(time < ta+tf-u, del, 0)
  }
  
  a <- Score_DE(time = t, event = delta, CP = CP, shape_weib = shape0, scale_weib = scale0, distr = 'Weibull')[2]
  c <- compute_pval(sampling = sampling_cont, T_exp_obs = t, delta_exp_obs = delta, CP = CP, shape_weib = shape0, 
                    scale_weib = scale0, distr = 'Weibull',tau = ta+tf, net = net)
  
  out <- data.frame(n_pat = nexp,
                    n_evts = sum(delta),
                    err_de = ifelse((a<0.05), 1, 0),
                    err_bay_de = ifelse((c<0.05), 1, 0))
  return(out)
}
